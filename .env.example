# Copy this file to .env - most configuration now lives in fobles.environments.json instead
# (copy fobles.environments.example.json to fobles.environments.json and edit that: test
# environments, Sitecore CLI login targets, and test user credentials all live there).
# Passwords are never stored in that file directly; run `npm run secret:set -- <NAME>` for
# whatever passwordSecretName each testUser entry references.
PLAYWRIGHT_AUTH_DIR=./tests/test-artifacts/auth
PLAYWRIGHT_PROFILE_DIR=./tests/test-artifacts/browser-profile