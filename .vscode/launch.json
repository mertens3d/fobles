{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Playwright Strategies (Parallel)",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": [
        "test",
        "-c",
        "tests/playwright.config.ts",
        "--retries=0",
        "--project=edge-parallel",
        "tests/e2e/parallel/strategies"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Playwright Toolbar Drag Test",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": [
        "test",
        "-c",
        "tests/playwright.config.ts",
        "--retries=0",
        "--project=edge-stateful",
        "--project=edge-stateful",
        "tests/e2e/stateful/00-session-start.spec.ts",
        "tests/e2e/stateful/toolbar-ui/drag.spec.ts",
        "tests/e2e/stateful/zz-session-end.spec.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Playwright Toolbar Other Test",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": [
        "test",
        "-c",
        "tests/playwright.config.ts",
        "--retries=0",
        "--project=edge-stateful",
        "--project=edge-stateful",
        "tests/e2e/stateful/00-session-start.spec.ts",
        "tests/e2e/stateful/toolbar",
        "tests/e2e/stateful/zz-session-end.spec.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
