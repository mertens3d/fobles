// @source-path [fobles] src/content/foundation/sitecore/quick-info.types.ts

// What the Content Editor's Quick Info panel says about the current item. Read by foundation/sitecore/quick-info.ts.
export type QuickInfoTemplate = {
  path: string | undefined;
  id: string | undefined;
};

export type QuickInfo = {
  itemId: string | undefined;
  itemName: string | undefined;
  itemPath: string | undefined;
  template: QuickInfoTemplate | undefined;
  icon: string | undefined;
  // Diagnostics only: the raw quick-info panel markup this was parsed from.
  rawMarkup: string | undefined;
};
