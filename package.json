{
  "name": "fobles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "validate": "npm run typecheck:extension && npm run typecheck:tests && npm run lint && npm run test:unit && npm run build:extension && npm run test:e2e -- --list",
    "lint": "eslint . --cache --cache-location .eslintcache --concurrency=auto",
    "build:extension": "node tools/scripts/build/build-extension.js",
    "typecheck:extension": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "typecheck:history": "tsc --noEmit -p tests/item-history.tsconfig.json",
    "test:unit:history": "node --test \"tests/unit/item-history/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\" \"src/content/sitecore-data/*.test.ts\"",
    "check:node": "node tools/scripts/dev/check-node-version.js",
    "sitecoreCLI:login": "node tools/scripts/dev/sitecore-cli-login.js",
    "sitecoreCLI:pull": "node tools/scripts/dev/sitecore-cli-pull.js",
    "sitecoreCLI:push": "node tools/scripts/dev/sitecore-cli-push.js",
    "secret:set": "node tools/scripts/dev/secure-secret-store.js set",
    "secret:remove": "node tools/scripts/dev/secure-secret-store.js remove",
    "test:report:open": "start \"\" \"playwright/test-artifacts/reports/test-report.html\"",
    "test:e2e": "playwright test -c tests/playwright.config.ts --retries=0",
    "check:extension-commands": "node tools/scripts/test/check-extension-commands.js",
    "code:sync-yml-const-paths": "node tools/scripts/test/sync-yml-consts.js",
    "build:scss": "sass src/content/styles/fobles-extension.scss dist/unpacked/fobles.css --no-source-map"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.2.9",
    "@types/cytoscape-fcose": "^2.2.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^16.6.1",
    "esbuild": "^0.27.2",
    "eslint": "^10.11.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.12.0",
    "happy-dom": "^21.0.4",
    "sass": "^1.97.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "cytoscape": "^3.34.3",
    "cytoscape-cose-bilkent": "^4.1.0",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-fcose": "^2.2.0",
    "cytoscape-popper": "^4.0.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "strip-ansi": "^7.2.0",
    "tippy.js": "^6.3.7"
  }
}
