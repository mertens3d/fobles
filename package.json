{
  "name": "fobles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build:extension": "node tools/scripts/build/build-extension.js",
    "check:node": "node tools/scripts/dev/check-node-version.js",
    "sitecoreCLI:login": "node tools/scripts/dev/sitecore-cli-login.js",
    "sitecoreCLI:pull": "node tools/scripts/dev/sitecore-cli-pull.js",
    "sitecoreCLI:push": "node tools/scripts/dev/sitecore-cli-push.js",
    "secret:set": "node tools/scripts/dev/secure-secret-store.js set",
    "secret:remove": "node tools/scripts/dev/secure-secret-store.js remove",
    "test:e2e": "playwright test -c tests/playwright.config.ts --retries=0",
    "test:e2e:toolbar": "playwright test -c tests/playwright.config.ts --retries=0 tests/e2e/00-session-start.spec.ts tests/e2e/toolbar tests/e2e/zz-session-end.spec.ts",
    "test:e2e:strategies": "playwright test -c tests/playwright.config.ts --retries=0 tests/e2e/00-session-start.spec.ts tests/e2e/strategies tests/e2e/zz-session-end.spec.ts",
    "test:e2e:strategies:update": "npm run test:e2e:strategies -- -u",
    "test:e2e:editor": "playwright test -c tests/playwright.config.ts --retries=0 tests/e2e/00-session-start.spec.ts tests/e2e/editor tests/e2e/zz-session-end.spec.ts",
    "test:e2e:extension-ui": "playwright test -c tests/playwright.config.ts --retries=0 tests/e2e/extension-ui",
    "test:e2e:extension-ui:persistence": "playwright test -c tests/playwright.config.ts --retries=0 tests/e2e/extension-ui/persistence",
    "test:e2e:extension-ui:toolbar": "playwright test -c tests/playwright.config.ts --retries=0 tests/e2e/extension-ui/toolbar-integration",
    "test:e2e:extension-ui:runtime": "playwright test -c tests/playwright.config.ts --retries=0 tests/e2e/extension-ui/extension-integration",
    "test:e2e:promoVideo": "playwright test -c tests/playwright.config.ts --retries=0 tests/e2e/00-session-start.spec.ts tests/e2e/promoVideo/promoVideo-demo.spec.ts tests/e2e/zz-session-end.spec.ts",
    "test:e2e:promoVideo:smoke": "playwright test -c tests/playwright.config.ts --retries=0 tests/e2e/promoVideo/smoke-test.spec.ts",
    "test:e2e:promoVideo:save": "node tools/scripts/test/save-promo-video.js",
    "test:e2e:list": "playwright test -c tests/playwright.config.ts --project=edge --list",
    "test:e2e:debug": "playwright test -c tests/playwright.config.ts --debug",
    "test:e2e:unlock": "node tools/scripts/test/unlock-browser-profile.js",
    "typecheck:extension": "tsc --noEmit -p tsconfig.json",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "build:scss": "sass src/content/styles/fobles-extension.scss dist/unpacked/fobles.css --no-source-map"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "dotenv": "^16.6.1",
    "esbuild": "^0.27.2",
    "eslint": "^10.11.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "sass": "^1.97.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.1"
  }
}
