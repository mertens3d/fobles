// @source-path [fobles] src/content/foundation/sitecore/fobles-strategy.types.ts

// How a field's value is turned into a reference to another Sitecore item. Recorded on field-reference provenance in the
// Reference Model, and used by the Content Editor augmentor to pick a button strategy.
export type FoblesStrategy =
  | "drop-link"
  | "drop-tree"
  | "droplist"
  | "file"
  | "general-link"
  | "icon"
  | "image"
  | "internal-link"
  | "multilist-options"
  | "multilist-with-search"
  | "quick-info-section"
  | "reference-links"
  | "style-checklist"
  | "tag-list"
  | "template-path"
  | "tree-list"
  | "treelist-ex";
