# Copy this file to .env and replace the placeholder with a local test environment.
# version is xp (Identity Server login form) or ai (SitecoreAI's Auth0 Universal Login).
SITECORE_TEST_ENVIRONMENTS=https://sitecore.example.invalid/sitecore|example|xp
#SITECORE_TEST_ENVIRONMENTS=https://example.sitecorecloud.io/|example|ai
PLAYWRIGHT_AUTH_DIR=./tests/test-artifacts/auth
PLAYWRIGHT_PROFILE_DIR=./tests/test-artifacts/browser-profile

# Optional - if both are set, tests submit the environment's login form automatically instead of
# pausing for a manual login. Leave unset to keep the manual-login flow.
SITECORE_TEST_USER_NAME=[username]
SITECORE_TEST_USER_PASSWORD=[password]