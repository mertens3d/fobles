{
  "manifest_version": 3,
  "name": "Fobles",
  "version": "1.0.0",
  "description": "Navigation and productivity helpers for Sitecore editors",
  "icons": {
    "16": "foble_icon.png",
    "32": "foble_icon.png",
    "48": "foble_icon.png",
    "128": "foble_icon.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "css": ["fobles.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "foble_icon.png",
      "32": "foble_icon.png",
      "48": "foble_icon.png",
      "128": "foble_icon.png"
    },
    "default_title": "Fobles",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-fobles": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle Fobles on/off"
    }
  }
}
