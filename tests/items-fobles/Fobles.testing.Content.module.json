{
  "$schema": "../../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "fobles.content",
  "description": "fobles.content",
  "references": ["fobles.templates"],
  "items": {
    "includes": [
      {
        "name": "fobles.content",
        "path": "/sitecore/Content/Fobles Testing",
        "database": "master",
        "allowedPushOperations": "CreateUpdateAndDelete",
         "rules": [
           {
            "path": "/Fobles Testing Site/Fobles Testing Site/Dictionary",
            "scope": "ItemAndDescendants"
          },
          {
            "path": "/Fobles Testing Site/Fobles Testing Site/Settings",
            "scope": "ItemAndDescendants"
          },
          {
            "path": "/Fobles Testing Site/Fobles Testing Site/Data",
            "scope": "ItemAndDescendants"
          },
          {
            "path": "/Fobles Testing Site/Fobles Testing Site/Presentation",
            "scope": "ItemAndDescendants"
          },
          {
            "path": "/Fobles Testing Site/Fobles Testing Site/Home",
            "scope": "ItemAndDescendants"
          },
          {
            "path": "/Fobles Testing Site/Fobles Testing Site",
            "scope": "SingleItem"
          },
          {
            "path": "/Fobles Testing Site",
            "scope": "SingleItem"
          },
          {
            "path": "*",
            "scope": "Ignored"
          }
        ]
      }
    ]
  }
}