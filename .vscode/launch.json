{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Playwright Strategies",
      "type": "pwa-node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": [
        "test",
        "-c",
        "tests/playwright.config.ts",
        "--retries=0",
        "tests/e2e/00-session-start.spec.ts",
        "tests/e2e/toolbar",
        "tests/e2e/zz-session-end.spec.ts"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
